DEEPSEEK_API_KEY=
TAVILY_API_KEY=
POLYGON_PRIVATE_KEY=
POLYGON_WALLET_ADDRESS=
MAX_BET_USDC=10
MIN_EDGE=0.07
MIN_CONFIDENCE=medium
DRY_RUN=true

# --- Signal tuning (optional) ---
# Dynamic news window: fast markets use the min, slow-moving markets widen toward max.
NEWS_WINDOW_MIN_DAYS=3
NEWS_WINDOW_MAX_DAYS=30
# Run a second, negation-focused Tavily query per market to reduce overconfidence.
COUNTER_EVIDENCE=true
# Skip bets at extreme prices (noisy edge, poor risk/reward).
MIN_PRICE=0.05
MAX_PRICE=0.95
# Comma-separated categories to skip entirely, e.g. sports,entertainment
DISABLED_CATEGORIES=
