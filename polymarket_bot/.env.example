# --- AI scoring (Gemini + built-in Google Search grounding) ---
# Free key in ~2 min at https://aistudio.google.com  (Get API key -> Create).
# Free tier: 1,500 requests/day, 15 requests/min, $0 cost.
GEMINI_API_KEY=
# Optional model overrides.
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_MODEL_PRO=gemini-2.5-pro
# Toggle built-in Google Search grounding (Gemini fetches its own news).
GEMINI_USE_SEARCH=true
# Second opinion from the Pro model on high-edge, high-confidence picks.
GEMINI_PRO_RECHECK=true
# Free-tier rate limit (requests/min). Raise/set 0 for paid Vertex keys.
GEMINI_RPM=15

# --- Trading (only needed for --trade mode) ---
POLYGON_PRIVATE_KEY=
POLYGON_WALLET_ADDRESS=
MAX_BET_USDC=10
MIN_EDGE=0.07
MIN_CONFIDENCE=medium
DRY_RUN=true

# --- Signal filters (optional) ---
# Skip bets at extreme prices (noisy edge, poor risk/reward).
MIN_PRICE=0.05
MAX_PRICE=0.95
# Comma-separated categories to skip entirely, e.g. sports,entertainment
DISABLED_CATEGORIES=

# --- Quant engine (CLOB price history + order-book microstructure) ---
QUANT_ENABLED=true
# Run the quant tradeability gate before the AI call to save LLM budget.
QUANT_PREFILTER=true
# Fusion weights (ratio of AI fundamental vs quant microstructure signal).
AI_WEIGHT=0.6
QUANT_WEIGHT=0.4
# Tradeability gates.
MIN_BOOK_LIQUIDITY_USDC=200
MAX_SPREAD=0.06
# Price-history sampling (CLOB /prices-history interval + fidelity in minutes).
QUANT_HISTORY_INTERVAL=1w
QUANT_HISTORY_FIDELITY=60
# How strongly a quant/AI disagreement shrinks the blended edge (0..1).
DISAGREEMENT_PENALTY=0.5

# --- Systematic risk controls ---
# Half-Kelly base fraction; volatility scaling shrinks it on choppy books.
KELLY_FRACTION=0.5
VOL_SIZING=true
# Portfolio caps applied across one scan.
MAX_PORTFOLIO_EXPOSURE_USDC=50
MAX_CATEGORY_EXPOSURE_USDC=20
MAX_CONCURRENT_POSITIONS=5
# Drawdown circuit breaker (throttle sizing if recent P&L below -threshold). 0 disables.
MAX_DRAWDOWN_USDC=30
